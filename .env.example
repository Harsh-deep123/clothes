# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI / ChatGPT (server-only). Used by POST /api/chat — never expose in frontend.
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini (preferred for ZAYRO chat). Server-only.
GEMINI_API_KEY=
# Optional model override (default tries gemini-2.0-flash, then 1.5/2.5 flash)
# GEMINI_MODEL=gemini-2.0-flash

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# IPinfo Lite token (server-only). Used by GET /api/ipinfo — never expose this in frontend code.
IPINFO_TOKEN=

# Local MongoDB (Compass connection mongodb://localhost:27017/)
# On Vercel / production you MUST use MongoDB Atlas (mongodb+srv://...), not localhost.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=clothes

# JWT for customer login (server-only) — set a long random secret in production
JWT_SECRET=

# Stripe (server-only secret). Publishable key is returned by GET /api/stripe/config.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Admin notification targets
ADMIN_EMAIL=harshdhiman613@gmail.com
ADMIN_WHATSAPP=917681987334

# Email (Nodemailer SMTP) — required to email return/replace requests to ADMIN_EMAIL
# Gmail example: create an App Password, then:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="ZAYRO STORE <your-gmail@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp / SMS — pick ONE WhatsApp path, SMS is optional fallback
# 1) Twilio WhatsApp:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# 2) Meta WhatsApp Cloud API:
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# 3) Twilio SMS fallback to 7681987334:
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_FROM_NUMBER=
# Twilio SMS OTP (registration). TWILIO_PHONE_NUMBER is preferred; TWILIO_FROM_NUMBER is used if unset.
TWILIO_PHONE_NUMBER=
# Twilio Voice uses TWILIO_FROM_NUMBER as the caller ID for order confirmation calls.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional map providers. Leave unset to use OpenStreetMap (no API key required).
# VITE_NOMINATIM_URL="/api/nominatim"
# VITE_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# VITE_MAP_TILE_ATTR="&copy; OpenStreetMap contributors"
